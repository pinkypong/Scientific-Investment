# .secrets.ps1  (이 파일을 .secrets.ps1 로 복사해 값 채우기 — .gitignore 대상)
#
# value-growth-screener(VGS) 전용 자격증명. VGS 는 data_sources/.env 를 **읽지 않고**
# os.getenv 로 셸 환경변수만 본다 (src/vgs/data/alpaca.py, factors.py, cli.py).
# 그래서 .env 가 아니라 이 파일에 넣고 셸에서 dot-source 한다:
#
#   . .\.secrets.ps1          # 현재 PowerShell 세션에만 적용
#   python -m vgs.cli ...     # 그 세션에서 VGS 실행
#
# bash 를 쓰면 .secrets.sh 로 같은 내용을 export 해서 `source ./.secrets.sh` 한다.
#
# 값을 채우지 않아도 VGS 의 오프라인 기능과 테스트는 돈다. 아래 키는 **실제 수집**
# (sec-sectors / sec-snapshot / FRED / Alpaca) 할 때만 필요하다.
#
# ⚠ 이 파일에 값을 채운 뒤에는 절대 커밋하지 않는다. pre-commit 훅과 .gitignore 가
#   막지만, 커밋 전 `git status` 로 .secrets.ps1 이 없는지 직접 확인한다.

# ── SEC EDGAR — VGS 용 User-Agent ─────────────────────────────────────
#   SEC 정책상 이름/조직 + 연락 이메일이 식별 가능해야 한다.
#   주의: data_sources/ 는 같은 용도로 SEC_EDGAR_USER_AGENT 라는 **다른 이름**을 쓴다.
#   두 서브시스템이 독립이라 이름이 다르다 — 양쪽 다 채워야 한다.
$env:SEC_USER_AGENT = "AI Stock Research <CONTACT_EMAIL>"

# ── FRED (거시 팩터) ──────────────────────────────────────────────────
#   발급: https://fred.stlouisfed.org/docs/api/api_key.html (무료)
$env:FRED_API_KEY = ""

# ── Alpaca (미국 시세 — 무료 IEX 데이터) ──────────────────────────────
#   발급: https://alpaca.markets → Paper trading 계정으로도 market data 조회 가능
#   읽기 전용 시세 조회에만 쓴다. 주문/거래 기능은 이 저장소에 없다.
$env:ALPACA_API_KEY_ID = ""
$env:ALPACA_API_SECRET_KEY = ""
