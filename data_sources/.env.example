# data_sources/.env  (이 파일을 .env 로 복사해 값 채우기 — git 미추적 권장)
#
# 이 파일은 **data_sources/.env 에서 읽히는 키만** 담는다. 다른 두 곳의 자격증명은
# 여기가 아니다 (자세한 건 docs/workflow.md "자격증명 세 곳"):
#   · Vercel 환경변수      — web_deploy/api/quotes.js (배포된 /api/quotes)
#   · 셸 환경변수(.secrets.ps1) — value-growth-screener (VGS). .env 를 읽지 않는다.

# ── OpenDART (한국 공시 재무) — 필수 (없으면 opendart BLOCKED) ─────────
#   발급: https://opendart.fss.or.kr  회원가입 → 인증키 신청 (무료, 즉시)
#   일 20,000건 제한
OPENDART_API_KEY=

# ── SEC EDGAR (미국 공시 재무) — 키 불필요, User-Agent 만 필요 ─────────
#   SEC 정책: 이름/조직 + 이메일. 비우면 config.providers.sec_edgar.user_agent 사용.
#   주의: VGS 는 같은 용도로 **SEC_USER_AGENT** 라는 다른 이름을 쓴다 (별도 서브시스템).
SEC_EDGAR_USER_AGENT=AI Stock Research <CONTACT_EMAIL>

# ── Bigdata.com (Phase E2 시장 데이터 SSOT) — 실수집 시에만 ────────────
#   https://bigdata.com → 구독 후 API 키. header X-API-KEY 로 전송된다.
#   재생성(--no-network)·테스트에는 불필요. 없으면 bigdata.rest --check 만 실패.
BIGDATA_API_KEY=

# ── 한국투자증권(KIS) Open API — 대시보드 한국 시세 ────────────────────
#   발급: https://apiportal.koreainvestment.com → 앱 등록 → APP KEY / APP SECRET
#   쓰는 곳: scripts/kis_check.mjs (로컬 점검). 배포본은 Vercel 환경변수를 쓴다.
#   재생성·테스트·CI 에는 불필요.
#   실전/모의 구분(KIS_ENV)은 여기가 아니라 **Vercel 환경변수**다. 로컬 점검 때는
#   kis_check.mjs 가 real→mock 순서로 알아서 둘 다 시험한다.
KIS_APP_KEY=
KIS_APP_SECRET=
